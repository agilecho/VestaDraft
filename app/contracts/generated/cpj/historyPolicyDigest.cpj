["object",[["derivation",["string","NS2-profile-input/1"]],["generation",["string","I33"]],["inputs",["array",[["object",[["logicalFile",["string","vesta-material:rev64/subtasks/application/history-effects.contract.json"]],["pointer",["string",""]],["projection",["string","complete-selected-JSON-value"]],["value",["object",[["authority",["string","DEC-P1-01 default native compatibility, parent instruction this turn; actual static source in main-callback-analysis-r5.json"]],["authorityChecks",["array",[["string","registry command ID + rowDigest + internal invocation class + current server-owned producer/session/profile determine effect. Public UI/Agent/CLI/MCP cannot assert producer authority by submitting profileDigest, skipHistory, historyEffect or a role string."],["string","same command dispatch/queue, stable documentId/epoch/expectedRevision/opId and existing authority apply before any mutation; animation sample requires its original server-owned session/tick identity and exact pref generation."],["string","Engine validates actual candidate change mask against registered producer mask. A supposedly view-only candidate containing selection/scientific/model/resource changes refuses E_HISTORY_EFFECT_PROFILE_MISMATCH before install; no silent fallback or privileged history suppression."],["string","internal schema is not a new public command endpoint. Adding a caller flag to an old177 request is a schema violation, not a migration shortcut."]]]],["changedCommitRules",["object",[["navigate-history",["array",[["string","stop/resolve animation and focus drafts first; move cursor minus/plus1 if inrange, clone stored target through qualified field mask and install; revision +=1; historyGeneration +=1 because cursor moved, no appended snapshot"],["string","when cursor=0 undo is boundary even if live camera differs from history[0]; no invented extra transient entry or discard-only Undo; when cursor=count-1 redo is boundary"],["string","navigation can replace transient camera changes with the stored target camera. Actual dirty compares restored live content to actual saved content."]]]],["noopFailureUnknown",["array",[["string","equal candidate: unchanged revision/history/digest, preserve redo and return unchanged"],["string","failure before install/cancel/stale: no committed state/history change; do not replay sample"],["string","unknown after delivery: query original operation in same lifecycle; no second mutation, no dependent navigation/save/close success, no auto retry or restart/reopen/reimport"]]]],["preserve-history-cursor",["array",[["string","on changed successful atomic install: replace active live immutable snapshot and only its owned leases; revision +=1"],["string","history IDs, cursor, count, historyGeneration and history-owned leases remain byte-identical; preserve any existing redo suffix"],["string","do not overwrite cursor stored snapshot with live camera state; it is needed for exact later Undo/Redo source semantics"],["string","recompute actual dirty/content digest independently; preserving history is not a claim of unchanged content or saved data"]]]],["record",["array",[["string","derive candidate from actual current live state, not stale history[cursor]"],["string","on actual changed successful atomic install: truncate redo suffix, append candidate snapshot, move cursor, apply capacity policy/resource leases; historyGeneration +=1; revision +=1"],["string","a later domain edit captures current camera state alongside its qualified changes; no implicit intermediate view-only history records"]]]]]]],["consumerMigration",["array",[["string","I32 technical interface revision and command registry metadata must explicitly add historyEffect classification and Live-vs-history distinction. All host/UI/Agent/CLI/MCP/observer consumers receive the same revised HistoryAwareCommitSummary."],["string","new summary historyGeneration changes on stored history/cursor mutation; preserve-history-cursor changes revision/live digest but not historyGeneration. Undo/Redo availability derives cursor/count, not revision or dirty."],["string","future validators reject unknown kind/skipHistory; update permission, idempotency, expected revision and resource-accounting consumers together in a reviewed isolated implementation card."],["string","old NS1 first-chain and original177 scientific request/response schema bytes remain retained; do not claim oldschema retroactively supports new effect metadata. Use explicit I32 successor namespace/negotiated adapter before runtime acceptance."],["string","this subtask writes only application sub-evidence; parent owns I32 authoritative text/current state/receipt and eventual manual dsh handoff."]]]],["defaultHistoryProfile",["string","native-compatible-camera-animation/1"]],["dirtyAndClose",["array",[["string","compare canonical actual save-relevant content (including persisted camera when codec saves it) and captured saved content, with exact format/profile/resource identity; native Scene dirtyfalse/unchangedhistory cannot close unsaved work"],["string","if equality or prior write completion is unknown, keep pending/unsaved and route existing explicit save/discard/cancel barrier; do not invent saved/clean"],["string","Save barrier stops admitting ticks, resolves original in-flight result and drafts, captures real current revision+content/resources, writes under existing host contract and reads back exact output; only then can Saved update that captured save claim"],["string","after Save, active revision/content may differ only if a later authorized mutation occurred; older save receipt never marks later content saved; close rechecks actual current content and unknown operations"],["string","preferences trim preserves both active live model/leases and cursor stored entry; explicit loss plan binds live revision/content, historyGeneration, exact lostSnapshotIds/resources and preference base generation. No model revision increment merely for trim."]]]],["nativeVsSafetyBoundary",["string","static native view-camera history request rules are frozen. Actual native timer cadence, counts, runtime vptr, platform renderer, active locale/FPCR and DataView synchronous/asynchronous notification behavior remain future qualifications. Retain stricter already-approved save/close/unknown-dirty safety contracts, not native dirty byte as authority."]],["oldAL3PerSample",["string","retained only as explicitly named corrected-animation-record/1 optional alternative; never implicit/native/default. No existingold document/schema is rewritten by this artifact."]],["producerRegistry",["array",[["object",[["allowedMutation",["string","camera rotation state only under captured qualified transform profile; no atom/site/bond/field/property/selection/resource mutation may piggyback"]],["effect",["string","preserve-history-cursor"]],["registeredInvocation",["string","qualified AL animation session camera sample (Drag/Click/Push/Random qualified view-only path)"]],["registration",["string","I32 new metadata on existing same Engine dispatcher and private animation-session owner; sample op derives producer from server-owned session and exact registered command route, not a caller string or privilege flag"]],["trustedProducerProfile",["string","native-compatible-camera-animation/1"]]]],["object",[["allowedMutation",["string","exact command registered mutation mask and existing scientifically qualified profile; noop/error still produce no history"]],["effect",["string","record"]],["registeredInvocation",["string","all other changed domain/model commands including existing177 scientific commands and qualified explicit selection reset/pick"]],["trustedProducerProfile",["string","registered-domain-record/1"]]]],["object",[["allowedMutation",["string","navigate1 stored cursor entry; no appending snapshot and no timer-count inference"]],["effect",["string","navigate-history"]],["registeredInvocation",["string","model Undo and Redo"]],["trustedProducerProfile",["string","registered-history-navigation/1"]]]],["object",[["allowedMutation",["string","existing contract only; a Save completion must not add model history or mark new content saved without actual writer/readback"]],["effect",["string","no domain-history action"]],["registeredInvocation",["string","query/save/render/layout/focus/preferences-only operations"]],["trustedProducerProfile",["string","existing non-domain effect classifications"]]]]]]],["requiredSemanticValidation",["array",[["string","historyCount>=1 and0<=historyCursor<historyCount; summary undoAvailable=(cursor>0), redoAvailable=(cursor+1<count)"],["string","all u64 increments checked; exhausted revision/historyGeneration refuses before mutation, never wraps"],["string","opaque registry/producer/animation/session/profile identities are server-resolved and capability-checked; digest text alone conveys no authority"],["string","complete candidate save-relevant content/resource graph compared independently of history cursor/native dirty flag"]]]],["schema",["string","p1-06-I32-history-effects-design/1"]],["schemaRef",["object",[["path",["string","vesta-material:rev64/subtasks/application/history-effects.schema.json"]],["sha256",["string","f0283291fb4303ca4c629edc5424599e05487c981407011e58c1e77e288a16ca"]]]]],["sources",["array",[["object",[["path",["string","vesta-material:rev64/subtasks/application/main-callback-analysis-r5.json"]],["sha256",["string","5a9efa1d40e8bd7f5867ce8f93c9b872149097d4533b1b3799db6e4aad62fc0c"]]]],["object",[["path",["string","vesta-material:rev64/subtasks/application/cached-native-successor-r2.json"]],["sha256",["string","1e00482fcce3131e6ee2a8220862be33f4235011fb04468cd7118c4ba9cc3670"]]]]]]],["stateDistinction",["object",[["capacity",["string","limits stored history records including cursor entry. Active live snapshot leases are separate and are not discarded to meet capacity. No double counting a transient active view snapshot as a stored record."]],["history",["string","ordered stored immutable snapshots and cursor; includes cursor entry but after preserve-history-cursor live content may differ from history[cursor]"]],["live",["string","immutable active model/content + resource leases at current monotonic revision"]],["saved",["string","last actual durable byte readback/work-reference bound saved content digest and uncertainty state; history cursor/native dirty byte cannot substitute"]]]]],["status",["string","current06 adjacent design successor for I32 migration; not implemented or independently reviewed"]]]]]]],["object",[["logicalFile",["string","vesta-material:rev65/contracts/history-effects-wire.schema.json"]],["pointer",["string",""]],["projection",["string","schema-validation-keywords-only"]],["value",["object",[["$defs",["object",[["HistoryAwareCommitSummary",["object",[["additionalProperties",["bool",false]],["properties",["object",[["cursorSnapshotDigest",["object",[["pattern",["string","^[0-9a-f]{64}$"]],["type",["string","string"]]]]],["documentId",["object",[["pattern",["string","^[0-9a-f]{32}$"]],["type",["string","string"]]]]],["epoch",["object",[["pattern",["string","^[0-9a-f]{32}$"]],["type",["string","string"]]]]],["historyCount",["object",[["pattern",["string","^(0|[1-9][0-9]*)$"]],["type",["string","string"]]]]],["historyCursor",["object",[["pattern",["string","^(0|[1-9][0-9]*)$"]],["type",["string","string"]]]]],["historyEffect",["object",[["enum",["array",[["string","record"],["string","preserve-history-cursor"],["string","navigate-history"],["string","unchanged"]]]]]]],["historyGeneration",["object",[["pattern",["string","^(0|[1-9][0-9]*)$"]],["type",["string","string"]]]]],["liveContentDigest",["object",[["pattern",["string","^[0-9a-f]{64}$"]],["type",["string","string"]]]]],["redoAvailable",["object",[["type",["string","boolean"]]]]],["revision",["object",[["pattern",["string","^(0|[1-9][0-9]*)$"]],["type",["string","string"]]]]],["undoAvailable",["object",[["type",["string","boolean"]]]]]]]],["required",["array",