        "inputDigest": {
          "$ref": "#/$defs/Digest"
        },
        "potentialUnit": {
          "const": "e/angstrom"
        },
        "energyUnit": {
          "const": "e^2/angstrom"
        },
        "energyAsymmetricDecimal": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$"
        },
        "generalMultiplicity": {
          "$ref": "#/$defs/U64"
        },
        "energyCellDecimal": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$"
        },
        "formulaUnitsPerCell": {
          "oneOf": [
