            "lossReportSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "explicit": {
              "const": true
            }
          },
          "required": [
            "sourceDigest",
            "profileId",
            "lossReportSha256",
            "explicit"
          ],
          "additionalProperties": false
        }
      ]
    },
