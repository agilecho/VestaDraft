              "$ref": "#/$defs/U64"
            }
          ]
        },
        "energyPerFormulaDecimal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$"
            }
          ]
        },
        "sitePotentials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emittedRow": {
                "$ref": "#/$defs/U64"
              },
              "sourceSiteMapDigest": {
                "$ref": "#/$defs/Digest"
              },
              "potentialDecimal": {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$"
              }
            },
            "required": [
              "emittedRow",
              "sourceSiteMapDigest",
              "potentialDecimal"
            ],
            "additionalProperties": false
          },
          "maxItems": 300,
          "minItems": 1
        },
        "numericAcceptanceReceipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ResourceRef"
            }
          ]
        },
        "energyEVAsymmetricDecimal": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$"
        },
        "energyMJmolAsymmetricDecimal": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$"
