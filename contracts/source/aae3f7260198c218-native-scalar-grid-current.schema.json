    "scalarPhysicalUnit": {
      "const": "source-unresolved"
    },
    "domainTreatment": {
      "const": "finite-including-every-stored-point"
    },
    "label": {
      "type": "string"
    },
    "ruleId": {
      "const": "draft.native-current-numerical-grid"
    },
    "ruleVersion": {
      "const": "1"
    }
  },
  "required": [
    "schemaVersion",
    "captureRole",
    "owner",
    "dataResource",
    "maskResource",
    "dataEncoding",
    "pointShape",
    "axisOrder",
    "originF64Bits",
    "stepColumnsF64Bits",
    "coordinateRole",
    "coordinatePhysicalUnit",
    "scalarRole",
    "scalarPhysicalUnit",
    "domainTreatment",
    "label",
    "ruleId",
    "ruleVersion"
