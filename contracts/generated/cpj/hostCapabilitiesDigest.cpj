edesHS3",["string","Do not require every shell/file API/other coordinator to join a global gate as a blanket design admission precondition. If caller requests stronger globalCAS, reply E_HOST_SCOPE_UNSUPPORTED; never silently label selected guarantee as stronger."]]]]]]],["object",[["logicalFile",["string","vesta-material:root/output/vesta-study/20261108-113622/reviews/20261117-224424-p1-04-host-save-application/attempts/20261118-004924-four-design-gaps/contracts/operation-recovery.contract.json"]],["pointer",["string",""]],["projection",["string","complete-selected-JSON-value"]],["value",["object",[["cleanup",["string","No cleanup from journal existence alone. Host terminal proof, owned exact candidate and no reachability/readers all required; uncertain retain sets survive until explicit verified resolution."]],["completion",["string","HS-02 own design now specified. Actual private store/volume qualification shared with HS-01; no assertion store implemented or trusted now."]],["crashOutcomes",["array",[["array",[["string","before intent durable"],["string","not permitted to publish; do not infer not-published from mere missing record after restart"]]],["array",[["string","intent exists, primary may have changed"],["string","commit-unknown until exact actual comparison"]]],["array",[["string","primary renamed, parent sync missing"],["string","commit-unknown, retain all possibly reachable artifacts"]]],["array",[["string","primary durable, complete record lost"],["string","committed-unverified/unknown; only matching protected registry and actual semantic evidence may prove original outcome"]]],["array",[["string","complete record trusted, actual target differs"],["string","historical completion only/current target conflict"]]],["array",[["string","journal caller-writable/corrupt/missing or no original source"],["string","expired-unresolved; self-consistent actual files may open only explicit new lifecycle"]]]]]],["predecessor",["object",[["path",["string","vesta-material:root/output/vesta-study/20261108-113622/reviews/20261117-224424-p1-04-host-save-application/attempts/20261117-232931-design-completion/contracts/host-recovery.contract.json"]],["sha256",["string","99c9aa0c9bf580a9bae92797f3ae625fda2cc6497429418965d8c78dbe479276"]]]]],["qualification",["object",[["designAuthored",["bool",true]],["hostImplemented",["bool",false]],["independentlyReviewed",["bool",false]],["runtimeValidated",["bool",false]]]]],["query",["object",[["lookup",["string","protected registry exact operation/profile/sequence; reject principal/target mismatch before work"]],["read",["string","reauthorize current actual space path, enumerate resource graph and compare full current materialized objects under03; stored passed/hash not enough"]],["reply",["string","closed status/proofScope/evidenceRef from HS/2 RecoveryReply; complete only exact captured snapshot. Query never writes primary, retries publication, rebinds current WorkRef, clears newer dirty, or closes draft"]],["request",["string","operationId+targetDigest only; authenticated principal from request context; no client path or trusted flag"]],["restart",["string","registry generation belongs to historical op, current service/claim is fresh; old page token never revives. Fresh UI may read historical outcome but cannot install old epoch as current"]]]]],["record",["object",[["actualFiles",["string","owned space refs+roles+sha+length; no work bytes here"]],["cleanup",["string","owned candidate retain set and reachability/reader leases"]],["expiresAt",["string","null unless explicitly retired; no invented duration"]],["identity",["string","exact document/epoch/revision/target/bindingIntent/sourceExpectation/artifactBinding/claim"]],["operationId",["string","host128bithex"]],["phase",["string","prepared|publication-intent|committed-unverified|complete|not-published|unknown"]],["previousDigest",["string","sha256|null; corruption detection only"]],["principalRef",["string","server-derived"]],["profileDigest",["string","sha256"]],["recordSequence",["string","monotonic u64"]],["registryGeneration",["string","128bithex persisted by host"]],["requestBinding",["string","server-issued captureGeneration/sequence + client requestId + commandDigest; not an arbitrary reusable request grant"]],["schema",["string","HS/3"]],["verification",["string","03 verifier/context/source/persisted semantic evidence refs"]]]]],["requestRetirement",["string","After restart old capture generation cannot admit mutation. Retired/missing operation IDs only query expired-unresolved; replay never creates a new operation. Fresh publish requires explicit new capture with a host-issued generation/sequence. Keep unresolved records and compact retired contiguous sequence intervals in same private metadata budget; do not need one permanent work-copy/tombstone per terminal record."]],["retention",["object",[["metadata",["string","existing DSH technical quota; atomic metadata admission before operation. No invented256MiB/TTL/Vesta numeric defaults or separate quota service"]],["sourceAndCandidates",["string","all work bytes in authorized personal space under existing quota; settings contain refs only"]],["terminal",["string","no wall-clock TTL required. Retire only after durable terminal+consumer acknowledgement+no reader/reachable references; query retired ID returns expired-unresolved; no operation ID reuse"]],["unresolved",["string","no eviction while may publish/reachable or source needed; quota pressure rejects new operation and preserves draft"]]]]],["schema",["string","HS/3-recovery"]],["storeOrder",["array",[["string","create exclusive generation temp under anchored private directory"],["string","serialize closed record; file sync; exact readback"],["string","atomic rename to immutable next generation; parent sync including newly created directory edges"],["string","update in-memory registry only after durable record succeeds; failed write keeps prior generation and uncertain may-publish state"]]]],["trustBoundary",["object",[["basis",["string","Existing platform space guards and sandbox health denyDSH probe demonstrate an available design route; not current Vesta deployment qualification. Same uid,0700 or hash alone are never sufficient."]],["location",["string","server-derived DSH_HOME/software/vesta/operations, private path separate from public software/<id>.json"]],["noNewService",["bool",true]],["noSecretOrSigningServiceRequired",["bool",true]],["subjects",["string","authenticated host adapter only writes; workspaceFiles/picker/HTTP paths remain space-guarded; Vesta CLI/shell sandbox must not grant this metadata path"]],["threat",["string","Browser/Agent/project-controlled bytes cannot fabricate original outcome; privileged host administrator compromise outside this adapter guarantee. Missing/failed isolation -> expired-unresolved/new-lifecycle only, never upgrade JSON to authority."]]]]]]]]]]]]]]]