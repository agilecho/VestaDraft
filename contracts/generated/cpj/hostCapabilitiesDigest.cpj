ntHostBinding",["object",[["actualVolumeAtImplementation",["string","runtime-derived canonical root/mount/account paths via existing QuotaStorage; historical XFS profile reference only, no current machine mount assumed"]],["designProfile",["string","Linux descriptor-anchored personal-space/dsh volumes under existing account isolation+quota"]],["limitAuthority",["string","QuotaStorage.usage actual kernel limits; metadata and work volumes separate, no new quota service or Sound limits"]],["platformHEAD",["string","a93149eb05795ded46a0d59e62aa94adf67832cd"]],["privateStore",["string","HS3 private DSH registry; actual sandbox full+space guards required to use it as original-operation evidence, otherwise explicit expired-unresolved/new-lifecycle recovery"]],["sourceFindings",["string","host-source-findings.json"]]]]],["migration",["string","HS/4 is internal explicit successor to HS/3 selected scope; old bytes and177 definitions/productprotocol3 untouched. Future server/client/receiver and capability admission must agree version."]],["predecessors",["array",[["object",[["path",["string","vesta-material:root/output/vesta-study/20261108-113622/reviews/20261117-224424-p1-04-host-save-application/attempts/20261118-004924-four-design-gaps/contracts/host-profile.contract.json"]],["sha256",["string","75807f2430753b7ee84759492c1e70a3bc3a2910513c6d9781f0179179739b93"]]]],["object",[["path",["string","vesta-material:root/output/vesta-study/20261108-113622/reviews/20261117-224424-p1-04-host-save-application/attempts/20261118-004924-four-design-gaps/contracts/operation-recovery.contract.json"]],["sha256",["string","6b00ec81f36c6d47d96b6578c59dff40893ae07383add8bd1cd790a330ec14c2"]]]]]]],["qualification",["object",[["accepted",["bool",false]],["actualHostImplemented",["bool",false]],["actualVestaRuntimeQualified",["bool",false]],["fullGlobalCASGuaranteed",["bool",false]],["independentlyReviewed",["bool",false]],["selectedDesignFrozen",["bool",true]]]]],["requiredVestaDeltas",["array",